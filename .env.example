# CRAFTCON 2K26 GAMING ARENA — ENVIRONMENT CONFIGURATION

# Server Settings
PORT=3000
NODE_ENV=development

# Turso / libSQL Database Credentials
# Production: Set TURSO_DATABASE_URL and TURSO_AUTH_TOKEN from Turso dashboard (https://turso.tech/)
# Development Fallback: If left blank or unset, local libSQL file (file:craftcon_gaming.db) is used automatically.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Razorpay Payment Gateway Credentials
# Replace with real keys from Razorpay Dashboard (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_craftcon2026
RAZORPAY_KEY_SECRET=craftcon_secret_key_2026
RAZORPAY_WEBHOOK_SECRET=craftcon_webhook_secret_2026
RAZORPAY_TEST_MODE=true

# Transactional Email Service Settings
# Provider options: 'console' (for local dev log output) | 'smtp' (for real emails)
EMAIL_PROVIDER=console
EMAIL_FROM=CRAFTCON 2K26 <no-reply@craftcon2026.edu>
ADMIN_EMAIL=admin@craftcon2026.edu

# Optional SMTP Server Details (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
